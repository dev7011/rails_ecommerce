<td class="px-6 py-4 whitepsace-nowrap tex-sm font-medium text-gray-800 underline">
  <% if p.images.any? %>
    <%= image_tag p.images&.first, class: "h-[50px] w-[50px] object-cover rounded rounded-b-2xl" %>
  <% else %>
    <%= image_tag "https://placehold.co/50x50?text=50x50", class: "h-[50px] w-[50px] object-cover rounded rounded-b-2x" %>
  <% end %>
</td>
<td class="px-6 py-4 whitepsace-nowrap tex-sm font-medium text-gray-800 underline">
  <%= link_to p.name, edit_admin_product_path(p) %>
</td>
<td class="px-6 py-4 whitepsace-nowrap tex-sm font-medium text-gray-800">
  <%= p.description %>
</td>
<td class="px-6 py-4 whitepsace-nowrap tex-sm font-medium text-gray-800">
  $<%= (p.price.to_f/100.0).to_s %>
</td>
