<div class="flex-full-center">
  <div class="flex-center w-[400px] rounded-[5px] bg-gradient-to-b from-blue-500 via-blue-600 to-blue-950 px-4 py-5">
    <div class="w-full max-w-3xl rounded-2xl border border-gray-200 bg-white px-6 py-5 shadow-xl sm:px-12 lg:px-10 lg:py-10">
      <h2 class="mb-4 text-center text-xl font-semibold text-gray-900 sm:text-xl">
        Login
      </h2>

      <%= form_for resource, as: resource_name, url: session_path(resource_name), html: { class: "space-y-8" } do |f| %>
        <div>
          <%= f.email_field :email,
                            autofocus: true,
                            autocomplete: "email",
                            placeholder: "email",
                            class: "utility_field" %>
        </div>

        <div class="relative">
          <%= f.password_field :password,
                               autocomplete: "current-password",
                               placeholder: "Password",
                               id: "login-password",
                               class: "utility_field" %>
          <button
            type="button"
            id="password-toggle"
            class="absolute right-5 top-1/2 -translate-y-1/2 text-gray-400 transition hover:text-blue-500"
            aria-label="Passwort anzeigen"
          >
            <svg
              id="eye-closed"
              xmlns="http://www.w3.org/2000/svg"
              class="h-7 w-7"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M3 3l18 18M10.6 10.7a2 2 0 002.7 2.7M9.9 4.2A10.8 10.8 0 0112 4c5.5 0 9 5.5 9 5.5a16.4 16.4 0 01-3.1 3.8M6.2 6.2C4.2 7.6 3 9.5 3 9.5S6.5 15 12 15c1 0 1.9-.2 2.7-.5"
                />
            </svg>

            <svg
              id="eye-open"
              xmlns="http://www.w3.org/2000/svg"
              class="hidden h-7 w-7"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6z"
                />
              <circle cx="12" cy="12" r="3" />
            </svg>
          </button>
        </div>

        <% if devise_mapping.recoverable? %>
          <div class="text-center">
            <%= link_to "Forgot password?",
                        new_password_path(resource_name),
                        class: "text-lg font-medium text-blue-500 transition hover:text-blue-700 hover:underline sm:text-xm" %>
          </div>
        <% end %>

        <% if devise_mapping.rememberable? %>
          <label class="flex cursor-pointer items-center gap-3 text-gray-600">
            <%= f.check_box :remember_me,
                            class: "h-5 w-5 rounded border-gray-300 text-blue-600 focus:ring-blue-500" %>

            <span>Remember me</span>
          </label>
        <% end %>

        <%= f.submit "Anmelden", class: "btn btn-primary" %>
      <% end %>
      <% if devise_mapping.registerable? %>
        <p class="mt-2 text-center text-lg text-gray-700 text-lg sm:text-lg">
          Don't have an account?

          <%= link_to "Signup",
                      new_registration_path(resource_name),
                      class: "font-medium text-blue-500 transition hover:text-blue-700 hover:underline text-lg sm:text-lg"%>
        </p>
      <% end %>
    </div>
  </div>
</div>