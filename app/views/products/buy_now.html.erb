<div class="mx-auto md:w-2/3 w-full flex">
  <div class="mx-auto">
    <div id="<%= dom_id @product %>">
      <p class="my-5">
        <strong class="block font-medium mb-1">Name:</strong>
        <%= @product.name %>
        <%= render "admin/products/images", images: @product.images %>
      </p>

      <p class="my-5">
        <strong class="block font-medium mb-1">Description:</strong>
        <%= @product.description %>
      </p>

      <p class="my-5">
        <strong class="block font-medium mb-1">Price:</strong>
        <%= @product.price %>
      </p>

      <p class="my-5">
        <strong class="block font-medium mb-1">Category:</strong>
        <%= @product.category.name%>
      </p>
    </div>

    <%= render "products/components/add_to_cart", product: @product %>

  </div>
</div>