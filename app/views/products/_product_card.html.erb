<div class="w-[350px] h-[400px] p-2 shadow-lg/50 flex flex-col">
  <div class="h-1/2 w-full">
    <%= image_tag(
          product.images.attached? ? product.images.first : "",
          class: "w-full h-full object-cover rounded-md",
          alt: ""
        ) %>
  </div>

  <div class="h-1/2 flex flex-col">
    <div class="text-sm text-gray-600 flex mt-5 flex-row justify-between font-bold items-center">
      <span><%= product.name %></span>
      <span><%= product.price %> €</span>
    </div>

    <div class="mt-3 text-gray-900 font-bold text-xl line-clamp-5">
      <%= product.description %>
    </div>

    <p class="mt-auto text-gray-700 text-base flex justify-end items-center ">
      <button class="px-5 py-2 text-white rounded-md bg-gray-600 hover:bg-gray-700 transition">
        <%= link_to "buy now", buy_now_product_path(product)%>
      </button>
    </p>
  </div>

</div>