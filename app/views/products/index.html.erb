<div class="w-full">
  <% if notice.present? %>
    <p
      class="py-2 px-3 bg-green-50 mb-5 text-green-500 font-medium rounded-lg inline-block"
      id="notice"
    >
      <%= notice %>
    </p>
  <% end %>

  <div class="w-full" data-controller="drag">
    <div class="grid grid-cols-4 gap-4 w-full">
      <% @admin_products.each do |product| %>
        <%= render "products/product_card", product: product  %>
      <% end %>
    </div>

    <%#== pagy_nav(@pagy) if @pagy.pages > 1 %>
  </div>

  <div class="mt-4">
    <%= link_to "Stock-liste", admin_stocks_path %>
  </div>
</div>