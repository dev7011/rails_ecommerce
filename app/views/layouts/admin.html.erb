<!DOCTYPE html>
<html>
<head>
  <title>Ecomm</title>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>

  <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  <%= javascript_importmap_tags %>
</head>

<body>
  <div class="container mx-auto shadow-lg shadow-gray-500">
    <div class="flex w-full">
      <nav class="w-64 p-4 bg-gray-600 min-h-[calc(100vh)]">
        <div class="flex h-">
          <%= image_tag 'logo.png', class: "w-16" %>
          <h1 class="text-md py-2 text-white font-bold hidden md:block">Ecomm Admin</h1>
        </div>
        <%= render "shared/admin/links_nav_bar" %>
      </nav>
      <div class="w-full p-8">
        <%= yield %>
      </div>
    </div>
  </div>
</body>
</html>